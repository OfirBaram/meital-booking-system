  <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;500;600;700;900&display=swap" rel="stylesheet">

  <style>
    * { -webkit-tap-highlight-color: transparent; }

    body {
      font-family: 'Heebo', sans-serif;
      background-color: #FAF5F0;
      color: #4A2E3A;
      -webkit-font-smoothing: antialiased;
    }

    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-track { background: #FAF5F0; }
    ::-webkit-scrollbar-thumb { background: #DDC3A5; border-radius: 2px; }

    /* ── Step transitions ── */
    .step-section {
      animation: fadeUp 0.35s ease both;
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(14px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ── Service cards ── */
    .service-card {
      border: 2px solid #F0E6EB;
      transition: border-color .2s, box-shadow .2s, transform .2s;
    }
    .service-card:hover  { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(166,124,142,.18); }
    .service-card:active { transform: translateY(0); }
    .service-card.selected {
      border-color: #A67C8E;
      background: linear-gradient(135deg,#FAF5F0 0%,#F5ECF0 100%);
      box-shadow: 0 4px 18px rgba(166,124,142,.2);
    }

    /* ── Calendar days ── */
    .cal-day {
      aspect-ratio: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
      font-size: .8rem;
      font-weight: 400;
      transition: background .15s, color .15s, transform .15s;
      cursor: pointer;
    }
    .cal-day.avail:hover  { background: rgba(166,124,142,.10); transform: scale(1.08); }
    .cal-day.selected     { background: linear-gradient(135deg,#C4A0B0,#A67C8E) !important; color: #fff !important; }
    .cal-day.today-ring   { outline: 2px solid #A67C8E; outline-offset: 1px; color: #A67C8E; font-weight: 600; }
    .cal-day.disabled     { opacity: .28; cursor: not-allowed; pointer-events: none; }

    /* ── Time slots ── */
    .time-slot {
      border: 2px solid #ECD9C6;
      border-radius: 12px;
      padding: .75rem .5rem;
      text-align: center;
      cursor: pointer;
      transition: border-color .15s, background .15s, color .15s, transform .15s;
    }
    .time-slot:hover   { border-color: #A67C8E; color: #A67C8E; transform: scale(1.04); }
    .time-slot.selected { background: #A67C8E; border-color: #A67C8E; color: #fff; box-shadow: 0 4px 12px rgba(166,124,142,.35); }

    /* ── OTP inputs ── */
    .otp-input {
      width: 46px; height: 58px;
      text-align: center;
      font-size: 1.4rem; font-weight: 700;
      border: 1.5px solid #E8D5C0;
      border-radius: 18px;
      background: #fff;
      color: #4A2E3A;
      outline: none;
      transition: border-color .15s, box-shadow .15s, transform .15s;
      caret-color: #A67C8E;
    }
    .otp-input:focus { border-color: #A67C8E; box-shadow: 0 0 0 3px rgba(166,124,142,.18); transform: scale(1.04); }
    .otp-input.filled { border-color: #A67C8E; background: #FBF6F9; }
    .otp-input.error  { border-color: #EF4444; box-shadow: 0 0 0 3px rgba(239,68,68,.12); animation: shake .3s ease; }
    @keyframes shake {
      0%,100% { transform: translateX(0); }
      25%      { transform: translateX(-4px); }
      75%      { transform: translateX(4px); }
    }

    /* ── Primary button ── */
    .btn-primary {
      background: linear-gradient(135deg, #A67C8E 0%, #8B6175 100%);
      transition: transform .2s, box-shadow .2s, opacity .2s;
    }
    .btn-primary:not(:disabled):hover  { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(166,124,142,.4); }
    .btn-primary:not(:disabled):active { transform: translateY(0); }
    .btn-primary:disabled { opacity: .45; cursor: not-allowed; }

    /* ── Spinner ── */
    @keyframes spin { to { transform: rotate(360deg); } }
    .spinner { animation: spin .75s linear infinite; }

    /* ── Confirmation pending clock ── */
    @keyframes drawHand {
      from { stroke-dashoffset: 24; }
      to   { stroke-dashoffset: 0; }
    }
    .clock-hand {
      stroke-dasharray: 24;
      stroke-dashoffset: 24;
      animation: drawHand .45s ease forwards .25s;
    }
    @media (prefers-reduced-motion: reduce) {
      .clock-hand { animation: none; stroke-dashoffset: 0; }
      #step-5 .animate-pulse { animation: none; }
    }

    /* ── Pulse dot (available indicator) ── */
    .dot-avail { width: 4px; height: 4px; border-radius: 50%; background: #A67C8E; margin-top: 2px; }

    /* ── Legal Modal ── */
    @keyframes modalSlideUp {
      from { opacity: 0; transform: translateY(40px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    #js-modal:not(.hidden) #js-modal-panel { animation: modalSlideUp .28s cubic-bezier(.22,.68,0,1.2) both; }
    @keyframes stepFadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    [id^="step-"]:not(.hidden) { animation: stepFadeIn .15s ease-out both; }
    .cal-day.animate-pulse { min-height: 2rem; }
    /* ── Maintenance Mode ── */
    @keyframes maintFloat {
      0%, 100% { transform: translateY(0); }
      50%       { transform: translateY(-8px); }
    }
    @keyframes maintSparkle {
      0%, 100% { opacity: 1; transform: scale(1) rotate(0deg); }
      50%       { opacity: .7; transform: scale(1.2) rotate(20deg); }
    }
    .maint-float   { animation: maintFloat 4s ease-in-out infinite; }
    .maint-sparkle { animation: maintSparkle 3s ease-in-out infinite; }
    .maint-wa-btn  { transition: transform .2s, box-shadow .2s; }
    .maint-wa-btn:hover  { transform: scale(1.04); box-shadow: 0 12px 32px rgba(37,211,102,.4); }
    .maint-wa-btn:active { transform: scale(1); }
  </style>
</head>

<body class="min-h-screen bg-cream font-heebo">

