    print('FOUND ' + str(len(found)) + ' adjacent string literal pair(s):')
    for prev, curr in found:
        a = prev[3][:80].encode('ascii', 'replace').decode()
        b = curr[3][:80].encode('ascii', 'replace').decode()
        print('  Line ' + str(prev[0]) + ' col ' + str(prev[1]) +
