      sendSMS(to, message);
      if (IS_SUPABASE_ENABLED && typeof CommunicationLogService !== 'undefined') {
        CommunicationLogService.log({ recipient_phone: to, context: context,
          status: 'SENT', message_body: message, detail: '' });
