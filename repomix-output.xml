  test('footer: privacy and accessibility modal triggers', async ({ page }) => {
    await expect(page.locator('[data-qa="btn-open-privacy"]')).toBeVisible()
    await expect(page.locator('[data-qa="btn-open-accessibility"]')).toBeVisible()
  })
})
