{
  "name": "meital-booking-system",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "dev": "vite",
    "build": "npm run css:build && vite build && npm run check:build",
    "preview": "vite preview",
    "serve": "serve frontend -p 4173",
    "css:build": "tailwindcss -i frontend/styles/input.css -o frontend/styles/tailwind.css --minify",
    "css:watch": "tailwindcss -i frontend/styles/input.css -o frontend/styles/tailwind.css --watch",
    "check:build": "node scripts/check-build-assets.mjs"
  },
  "devDependencies": {
    "serve": "^14.2.3",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "lit-html": "^3.3.3",
    "mixpanel-browser": "^2.80.0",
    "motion": "^12.40.0",
    "pg": "^8.21.0"
  }
}
