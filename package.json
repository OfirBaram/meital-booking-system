{
  "name": "meital-booking-system",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "test:backend": "vitest run --config vitest.backend.config.js",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "lint": "eslint tests/backend --ext .js",
    "dev": "vite",
    "build": "npm run css:build && vite build && npm run check:build",
    "preview": "vite preview",
    "serve": "serve frontend -p 4173",
    "css:build": "tailwindcss -i frontend/styles/input.css -o frontend/styles/tailwind.css --minify",
    "css:watch": "tailwindcss -i frontend/styles/input.css -o frontend/styles/tailwind.css --watch",
    "test:landing:unit": "vitest run --config vitest.landing.config.js",
    "test:landing:e2e": "playwright test --config playwright.landing.config.js",
    "test:landing": "npm run test:landing:unit && npm run test:landing:e2e",
    "check:build": "node scripts/check-build-assets.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "eslint": "^8.57.0",
    "jsdom": "^24.0.0",
    "serve": "^14.2.3",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.16",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "lit-html": "^3.3.3",
    "mixpanel-browser": "^2.80.0",
    "motion": "^12.40.0",
    "pg": "^8.21.0"
  }
}
